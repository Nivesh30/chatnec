# Copy to .env and fill in the platforms you're using. Unset platforms are simply inactive.

# --- Slack: create an app at api.slack.com/apps, enable Event Subscriptions
# pointing to https://<your-host>/webhook/slack, subscribe to message.channels.
# SLACK_SIGNING_SECRET is required, not optional — without it /webhook/slack
# rejects every request (there'd be nothing to verify inbound events against) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# --- Telegram: create a bot via @BotFather, then point its webhook at
# https://<your-host>/webhook/telegram (see TelegramAdapter.register_webhook) ---
TELEGRAM_BOT_TOKEN=

# --- Microsoft Teams as a bot: register a bot in Azure Bot Service, messaging
# endpoint https://<your-host>/webhook/teams. This is a separate bot identity
# that has to be added to a chat/channel — for acting as *your own* Teams
# identity instead, see TEAMS_USER_* below ---
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=

# --- Microsoft Teams, acting as you: reads/sends chat messages as your own
# signed-in identity via delegated Microsoft Graph permissions, not as a
# separate bot. Requires an Azure AD app registration (public client, no
# secret) with the Chat.ReadWrite delegated permission, and running
# `chatnec teams-login` once (requires: pip install chatnec[teams-user]).
# Polls for new messages every TEAMS_USER_POLL_INTERVAL_SECONDS ---
TEAMS_USER_CLIENT_ID=
TEAMS_USER_TENANT_ID=common
TEAMS_USER_POLL_INTERVAL_SECONDS=15

# --- WhatsApp: create a Meta app with the WhatsApp product, point its webhook at
# https://<your-host>/webhook/whatsapp, subscribe to the "messages" field.
# WHATSAPP_VERIFY_TOKEN is whatever you set in the Meta dashboard's webhook
# verification step. WHATSAPP_APP_SECRET is required, not optional — without
# it /webhook/whatsapp rejects every request ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- Discord: create a bot at discord.com/developers/applications, enable the
# "Message Content" privileged intent. No webhook URL needed — it connects
# itself via the Gateway. Requires: pip install chatnec[discord] ---
DISCORD_BOT_TOKEN=

# --- Agent integration ---
# embedded: pass a handler directly to create_app() in code (see examples/embedded_mode.py)
# http: connector POSTs to AGENT_WEBHOOK_URL and expects {"text": "..."} back
AGENT_MODE=embedded
AGENT_WEBHOOK_URL=
AGENT_TIMEOUT_SECONDS=30

# Required to use POST /reply (async agent replies) — the endpoint refuses all
# requests until this is set, and then requires it as the X-API-Key header.
REPLY_API_KEY=

# --- Session state --- (in-memory if unset; requires pip install chatnec[redis])
REDIS_URL=

# --- Observability ---
LOG_LEVEL=INFO
LOG_FORMAT=json
