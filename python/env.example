# Copy to .env and fill in the platforms you're using. Unset platforms are simply inactive.

# --- Slack: create an app at api.slack.com/apps, enable Event Subscriptions
# pointing to https://<your-host>/webhook/slack, subscribe to message.channels ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# --- Telegram: create a bot via @BotFather, then point its webhook at
# https://<your-host>/webhook/telegram (see TelegramAdapter.register_webhook) ---
TELEGRAM_BOT_TOKEN=

# --- Microsoft Teams: register a bot in Azure Bot Service, messaging endpoint
# https://<your-host>/webhook/teams ---
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=

# --- Agent integration ---
# embedded: pass a handler directly to create_app() in code (see examples/embedded_mode.py)
# http: connector POSTs to AGENT_WEBHOOK_URL and expects {"text": "..."} back
AGENT_MODE=embedded
AGENT_WEBHOOK_URL=
AGENT_TIMEOUT_SECONDS=30

# Shared secret required on POST /reply (async agent replies). Leave blank to disable.
REPLY_API_KEY=
